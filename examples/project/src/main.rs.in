//! %NAME%: the program, one crate. Its tests and benches sit beside the
//! code they check, under cfg(test); its fuzz targets are functions
//! under cfg(fuzzing).

#![no_std]
#![no_main]

extern crate alloc;

mod greet;
// The operating system, one file for each: the rest of the crate calls
// the same functions on all of them.
#[cfg_attr(target_os = "macos", path = "sys/macos.rs")]
#[cfg_attr(target_os = "linux", path = "sys/linux.rs")]
#[cfg_attr(target_os = "windows", path = "sys/windows.rs")]
mod sys;

use alloc::vec::Vec;
use core::ffi::c_char;

#[global_allocator]
static HEAP: sys::Heap = sys::Heap;

/// A panic is a bug: say where, and end the process.
#[panic_handler]
fn panic(info: &core::panic::PanicInfo<'_>) -> ! {
    sys::stderr(b"%NAME%: panic");
    if let Some(at) = info.location() {
        sys::stderr(b" at ");
        sys::stderr(at.file().as_bytes());
    }
    sys::stderr(b"\n");
    sys::die()
}

/// The program on its arguments; the exit status.
fn run(args: &[&[u8]]) -> i32 {
    let mut out = Vec::new();
    for name in args.iter().skip(1) {
        greet::greet(&mut out, name);
    }
    if args.len() < 2 {
        greet::greet(&mut out, b"");
    }
    sys::stdout(&out);
    0
}

#[unsafe(no_mangle)]
extern "C" fn main(argc: i32, argv: *const *const c_char) -> i32 {
    // rr: escape(unsafe): argc and argv are main's own.
    let args = unsafe { sys::args(argc, argv) };
    run(&args)
}
