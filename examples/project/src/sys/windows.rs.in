//! What the program needs of Windows: the heap, output, arguments and an
//! end on a bug, through kernel32.dll. The C runtime starts the program in
//! main and gives what the compiler calls, such as memcpy. The rest of the
//! crate calls only this; unsafe stays here.

use alloc::vec::Vec;
use core::alloc::{GlobalAlloc, Layout};
use core::ffi::{c_char, c_void};
use core::ptr::{null, null_mut};

// The C runtime: the DLL one, as Rust's own programs have it, or the
// static one with -C target-feature=+crt-static. Each brings its parts
// (vcruntime, ucrt) by itself.
#[cfg_attr(target_feature = "crt-static", link(name = "libcmt"))]
#[cfg_attr(not(target_feature = "crt-static"), link(name = "msvcrt"))]
// rr: escape(unsafe): it declares nothing; it only links the C runtime.
unsafe extern "C" {}

#[link(name = "shell32", kind = "raw-dylib")]
// rr: escape(unsafe): its signature is shell32's, from its documentation.
unsafe extern "system" {
    fn CommandLineToArgvW(line: *const u16, argc: *mut i32) -> *mut *const u16;
}

#[link(name = "kernel32", kind = "raw-dylib")]
// rr: escape(unsafe): each signature is kernel32's, from its documentation.
unsafe extern "system" {
    fn GetProcessHeap() -> *mut c_void;
    fn HeapAlloc(heap: *mut c_void, flags: u32, size: usize) -> *mut c_void;
    fn HeapReAlloc(heap: *mut c_void, flags: u32, p: *mut c_void, size: usize) -> *mut c_void;
    #[must_use]
    fn HeapFree(heap: *mut c_void, flags: u32, p: *mut c_void) -> i32;
    fn GetStdHandle(which: u32) -> *mut c_void;
    fn GetCommandLineW() -> *const u16;
    #[must_use]
    fn WideCharToMultiByte(
        page: u32,
        flags: u32,
        wide: *const u16,
        n: i32,
        out: *mut u8,
        size: i32,
        default: *const u8,
        used: *mut i32,
    ) -> i32;
    #[must_use]
    fn WriteFile(
        file: *mut c_void,
        p: *const u8,
        n: u32,
        written: *mut u32,
        overlapped: *mut c_void,
    ) -> i32;
}

/// The alignment HeapAlloc gives every block.
const HEAP_ALIGN: usize = 16;
const HEAP_ZERO_MEMORY: u32 = 8;
const STD_OUTPUT_HANDLE: u32 = (-11i32).cast_unsigned();
const STD_ERROR_HANDLE: u32 = (-12i32).cast_unsigned();
const CP_UTF8: u32 = 65001;

/// The global allocator: the process heap, as std's System is on
/// Windows. A block aligned beyond the heap's is taken larger and
/// aligned inside, with the heap's own pointer kept just before it.
pub struct Heap;

/// The process's heap.
fn heap() -> *mut c_void {
    // rr: escape(unsafe): the process heap is always there.
    unsafe { GetProcessHeap() }
}

/// A block for l, zeroed or not.
fn block(l: Layout, flags: u32) -> *mut u8 {
    let heap = heap();
    if l.align() <= HEAP_ALIGN {
        // rr: escape(unsafe): HeapAlloc takes a plain size.
        return unsafe { HeapAlloc(heap, flags, l.size()) }.cast();
    }
    let Some(total) = l.size().checked_add(l.align()) else {
        return null_mut();
    };
    // rr: escape(unsafe): HeapAlloc takes a plain size.
    let p = unsafe { HeapAlloc(heap, flags, total) }.cast::<u8>();
    if p.is_null() {
        return p;
    }
    // p is aligned to 16, l to more: the aligned block starts 16 bytes or
    // more into p's, which leaves room for the pointer before it.
    let offset = match p.align_offset(l.align()) {
        0 => l.align(),
        o => o,
    };
    let aligned = p.wrapping_add(offset);
    // rr: escape(unsafe, cast): the word before aligned lies within the block, past p.
    unsafe { aligned.cast::<*mut u8>().wrapping_sub(1).write_unaligned(p) };
    aligned
}

/// The heap's own pointer of a block of l.
fn origin(p: *mut u8, l: Layout) -> *mut c_void {
    if l.align() <= HEAP_ALIGN {
        return p.cast();
    }
    // rr: escape(unsafe, cast): block kept the heap's pointer just before p.
    unsafe { p.cast::<*mut u8>().wrapping_sub(1).read_unaligned() }.cast()
}

// Blocks come from the process heap and go back to it by the pointer
// it gave; an aligned block keeps that pointer before it: GlobalAlloc's
// contract holds.
// rr: escape(unsafe): GlobalAlloc is unsafe to implement.
unsafe impl GlobalAlloc for Heap {
    // rr: escape(unsafe): the signature GlobalAlloc requires.
    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
        block(l, 0)
    }

    // rr: escape(unsafe): the signature GlobalAlloc requires.
    unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
        block(l, HEAP_ZERO_MEMORY)
    }

    // rr: escape(unsafe): the signature GlobalAlloc requires.
    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
        // rr: escape(unsafe, discard): the block came from the process heap,
        // and dealloc has no way to say that freeing it failed.
        let _: i32 = unsafe { HeapFree(heap(), 0, origin(p, l)) };
    }

    // rr: escape(unsafe): the signature GlobalAlloc requires.
    unsafe fn realloc(&self, p: *mut u8, l: Layout, size: usize) -> *mut u8 {
        if l.align() <= HEAP_ALIGN {
            // rr: escape(unsafe): p is a live block of the process heap.
            return unsafe { HeapReAlloc(heap(), 0, p.cast(), size) }.cast();
        }
        let q = block(Layout::from_size_align(size, l.align()).unwrap_or(l), 0);
        if !q.is_null() {
            // rr: escape(unsafe): both blocks are live and hold at least this much.
            unsafe { core::ptr::copy_nonoverlapping(p, q, l.size().min(size)) };
            // rr: escape(unsafe, discard): p came from this heap and is not
            // used after; the new block is what realloc returns either way.
            let _: i32 = unsafe { HeapFree(heap(), 0, origin(p, l)) };
        }
        q
    }
}

fn write_all(which: u32, mut p: &[u8]) {
    // rr: escape(unsafe): the standard handles are the process's own.
    let handle = unsafe { GetStdHandle(which) };
    while !p.is_empty() {
        let n = u32::try_from(p.len()).unwrap_or(u32::MAX);
        let mut written = 0;
        // rr: escape(unsafe): p is readable memory of at least n bytes.
        let ok = unsafe { WriteFile(handle, p.as_ptr(), n, &raw mut written, null_mut()) };
        // An error, or nothing written: give up.
        if ok == 0 || written == 0 {
            return;
        }
        // More than was asked: the system broke its contract; give up.
        let Some(rest) = usize::try_from(written)
            .ok()
            .and_then(|count| p.get(count..))
        else {
            return;
        };
        p = rest;
    }
}

pub fn stdout(p: &[u8]) {
    write_all(STD_OUTPUT_HANDLE, p);
}

pub fn stderr(p: &[u8]) {
    write_all(STD_ERROR_HANDLE, p);
}

/// The program's arguments as byte strings, in UTF-8. The C runtime
/// gives main its argv in the system's code page, so Windows's own
/// command line, in UTF-16, is split as the C runtime splits it and
/// converted instead; argc and argv go unused.
///
/// # Safety
/// None beyond main's: it takes main's arguments to be called as the
/// other systems' args is.
// rr: escape(unsafe): the same signature as the other systems' args.
pub unsafe fn args(_argc: i32, _argv: *const *const c_char) -> Vec<&'static [u8]> {
    let mut argc = 0;
    // rr: escape(unsafe): the command line is the process's own and lives
    // as long as it.
    let line = unsafe { GetCommandLineW() };
    // rr: escape(unsafe): line is NUL-terminated; argc is a local
    // out-parameter.
    let argv = unsafe { CommandLineToArgvW(line, &raw mut argc) };
    if argv.is_null() {
        return Vec::new();
    }
    let argc = usize::try_from(argc).unwrap_or(0);
    // rr: escape(unsafe): CommandLineToArgvW gave argc pointers, kept for
    // the process.
    let wide = unsafe { core::slice::from_raw_parts(argv, argc) };
    // The UTF-8 of every argument, one after another, and where each is.
    let mut text = Vec::new();
    let mut spans = Vec::with_capacity(argc);
    for &w in wide {
        // A length of -1: up to the NUL, which is counted.
        // rr: escape(unsafe): w is NUL-terminated.
        let n =
            unsafe { WideCharToMultiByte(CP_UTF8, 0, w, -1, null_mut(), 0, null(), null_mut()) };
        let n = usize::try_from(n).unwrap_or(0);
        let at = text.len();
        text.resize(at + n, 0);
        let Some(to) = text.get_mut(at..) else { break };
        let size = i32::try_from(to.len()).unwrap_or(0);
        // rr: escape(unsafe): w is NUL-terminated; to has size bytes.
        let written = unsafe {
            WideCharToMultiByte(CP_UTF8, 0, w, -1, to.as_mut_ptr(), size, null(), null_mut())
        };
        // What the first call counted, or an argument that did not convert.
        if written != size {
            break;
        }
        spans.push((at, n.saturating_sub(1)));
    }
    // rr: escape(leak): the arguments live as long as the process, as
    // main's own do on the other systems.
    let text: &'static [u8] = text.leak();
    let mut out = Vec::with_capacity(spans.len());
    for (at, n) in spans {
        out.push(text.get(at..at + n).unwrap_or_default());
    }
    out
}

/// End the process at once, as abort does: a bug was found. Windows's
/// fast fail ends it without running anything more.
pub fn die() -> ! {
    // FAST_FAIL_FATAL_APP_EXIT.
    #[cfg(target_arch = "x86_64")]
    // rr: escape(unsafe): __fastfail does not return.
    unsafe {
        core::arch::asm!("int 0x29", in("ecx") 7, options(noreturn, nostack));
    }
    #[cfg(target_arch = "aarch64")]
    // rr: escape(unsafe): __fastfail does not return.
    unsafe {
        core::arch::asm!("brk #0xf003", in("x0") 7, options(noreturn, nostack));
    }
}
